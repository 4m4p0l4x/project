---
import { experiences } from '../data/experience';
---

<section id="experience" class="py-20 bg-black/90 text-purple-900">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold text-center mb-12 tracking-tight">
      My Experience
    </h2>

    <div class="max-w-4xl mx-auto space-y-8">
      {experiences.map((exp) => (
        <article class="bg-gray-50 p-6 sm:p-8 rounded-lg shadow-md border border-gray-200/50">
          <div class="flex flex-col md:flex-row md:items-center justify-between mb-2 gap-2">
            <div class="flex items-center">
              <i class={`${exp.icon} text-2xl mr-3 text-purple-900`}></i>
              <h3 class="text-2xl font-semibold text-purple-900">
                {exp.role}
              </h3>
            </div>
            <span class="text-sm font-semibold text-purple-900">
              {exp.period}
            </span>
          </div>

          <p class="text-sm text-gray-600 font-semibold mb-3">
            {exp.company}
          </p>

          <ul class="text-gray-700 mb-5 space-y-2 list-disc list-inside text-sm leading-relaxed">
            {exp.description.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-2">
            {exp.technologies.map((tech) => (
              <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

