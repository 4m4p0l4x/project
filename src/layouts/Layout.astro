---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Take a Chance on Me | Anahi Amapola Cancino",
  description = "Portfolio of a Software Developer specialized in Mobile, Backend, Linux, and Open Source",
} = Astro.props;
const assetBase = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Favicon -->
    <link
      rel="icon"
      href={`${assetBase}assets/icons/icon.png`}
      type="image/png"
    />

    <!-- Font Awesome Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body
    class="bg-gray-50 text-gray-900 antialiased selection:bg-purple-900 selection:text-white"
  >
    <slot />
  </body>
</html>
