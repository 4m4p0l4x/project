---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="py-12 bg-gray-200">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold text-center mb-8 text-purple-900 tracking-tight">
      Featured Projects
    </h2>

    <!-- Modular Projects Container: Future projects drop in automatically via src/data/projects.ts -->
    <div class="max-w-6xl mx-auto space-y-12">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>

