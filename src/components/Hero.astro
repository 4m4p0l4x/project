---
---

<section 
  id="hero" 
  class="relative min-h-screen flex items-center justify-center text-white pt-20"
>
  <!-- Dark overlay to ensure crisp readability over the Hubble starfield background -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-950/85 via-blue-900/80 to-indigo-950/90 z-0"></div>

  <div class="container mx-auto px-6 text-center relative z-10 py-16">
    <div class="hero-content max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold mb-6 opacity-0 slide-up tracking-tight leading-tight">
        Anahi Amapola Cancino Santelices
        <span class="block text-blue-200 text-3xl sm:text-4xl md:text-5xl mt-2 font-semibold">
          Software Developer
        </span>
      </h1>

      <div class="text-xl sm:text-2xl md:text-3xl mb-8 opacity-0 slide-up font-medium" style="animation-delay: 0.3s">
        <span class="inline-block mx-2">Mobile and Fullstack developer</span>
        <span class="text-blue-400 font-light">|</span>
        <span class="inline-block mx-2">Systems & Open Source</span>
      </div>

      <p class="text-base sm:text-lg md:text-xl mb-10 opacity-0 slide-up max-w-3xl mx-auto leading-relaxed text-blue-100/90" style="animation-delay: 0.5s">
        Software developer with experience in mobile development at a leading global consulting firm, 
        plus working knowledge of backend systems and automation. Open-source tooling maintainer, committed to writing reliable software and solving problems across the engineering stack.
      </p>

      <!-- 3-Button Layout: Experience & Contact top row, View Projects centered underneath -->
      <div class="flex flex-col items-center opacity-0 slide-up" style="animation-delay: 0.7s">
        <div class="flex flex-wrap justify-center gap-4 sm:gap-6 mb-6">
          <a 
            href="#experience" 
            class="bg-white text-blue-900 px-8 py-3 rounded-lg font-semibold hover:bg-blue-50 hover:shadow-lg transition duration-300"
          >
            My Experience
          </a>
          <a 
            href="#contact" 
            class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-950 transition duration-300"
          >
            Contact
          </a>
        </div>
        <div>
          <a 
            href="#projects" 
            class="border-2 border-blue-300 text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-950 hover:border-white transition duration-300 inline-block"
          >
            View Projects
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

